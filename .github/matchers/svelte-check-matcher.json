{
	"problemMatcher": [
		{
			"owner": "svelte-check",
			"severity": "error",
			"pattern": [
				{
					"regexp": "^([^\\s].*):(\\d+):(\\d+)$",
					"file": 1,
					"line": 2,
					"column": 3
				},
				{
					"regexp": "^Error:\\s*(.*)$",
					"message": 1
				}
			]
		},
		{
			"owner": "svelte-check-warning",
			"severity": "warning",
			"pattern": [
				{
					"regexp": "^([^\\s].*):(\\d+):(\\d+)$",
					"file": 1,
					"line": 2,
					"column": 3
				},
				{
					"regexp": "^Warn:\\s*(.*)$",
					"message": 1
				}
			]
		}
	]
}
